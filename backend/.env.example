# Serverni ishga tushirish uchun sozlamalar.
# Haqiqiy .env faylini git'ga QO'SHMANG (u .gitignore'da).

# Ma'lumotlar bazasi. Mac'da sinash uchun SQLite yetarli.
# Ishlab chiqarishда PostgreSQL: postgresql://user:parol@host:5432/hp_dlp
DATABASE_URL=sqlite:///./hp_dlp.db

# Agentlar serverga shu kalit bilan ulanadi (X-API-Key sarlavhasi).
AGENT_API_KEY=dev-agent-key-change-me

# Token imzolash uchun maxfiy kalit (uzun, tasodifiy qiymatga almashtiring).
SECRET_KEY=dev-secret-change-me

# Birinchi ishga tushishda yaratiladigan standart admin (keyin parolni almashtiring).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Panel manzili (CORS uchun). Vergul bilan bir nechta.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Skrinshot va fayllar saqlanadigan papka.
MEDIA_DIR=./media
